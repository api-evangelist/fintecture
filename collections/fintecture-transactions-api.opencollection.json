{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fintecture Account Information Services Accounts Transactions API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transactions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Account Transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fintecture.com/ais/v1/customer/:customer_id/account/:account_id/transactions",
            "params": [
              {
                "name": "customer_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "from",
                "value": "",
                "type": "query"
              },
              {
                "name": "to",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns all transactions linked to the requested account."
        },
        {
          "info": {
            "name": "List All Transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fintecture.com/v1/transactions",
            "params": [
              {
                "name": "filter[from]",
                "value": "",
                "type": "query"
              },
              {
                "name": "filter[to]",
                "value": "",
                "type": "query"
              },
              {
                "name": "filter[type]",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List All Transactions"
        },
        {
          "info": {
            "name": "Get Specific Transaction",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fintecture.com/v1/transactions/:transaction_id",
            "params": [
              {
                "name": "transaction_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Specific Transaction"
        }
      ]
    }
  ],
  "bundled": true
}