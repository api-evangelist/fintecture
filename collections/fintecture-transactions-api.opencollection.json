{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fintecture Transactions and Settlements API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transactions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List All Transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fintecture.com/v1/transactions",
            "params": [
              {
                "name": "filter[from]",
                "value": "",
                "type": "query"
              },
              {
                "name": "filter[to]",
                "value": "",
                "type": "query"
              },
              {
                "name": "filter[type]",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List All Transactions"
        },
        {
          "info": {
            "name": "Get Specific Transaction",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fintecture.com/v1/transactions/:transaction_id",
            "params": [
              {
                "name": "transaction_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Specific Transaction"
        }
      ]
    },
    {
      "info": {
        "name": "Sandbox",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Simulate A Transaction",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fintecture.com/v1/transactions/simulate",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Simulate a credit/debit transaction in the Sandbox environment. Use this to test webhook and event flows."
        }
      ]
    }
  ],
  "bundled": true
}