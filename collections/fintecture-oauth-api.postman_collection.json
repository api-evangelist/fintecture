          "name": "Create Access Token",
          "request": {
            "name": "Create Access Token",
            "description": {
              "content": "The access token endpoint enables the TPP to authenticate to the Fintecture Authentication Server. Two grant types are supported — `authorization_code` for AIS, and `client_credentials` for PIS, Customers, E-Mandates, and the beta OAC (Organisation Access Credentials) scopes.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oauth",
                "accesstoken"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
