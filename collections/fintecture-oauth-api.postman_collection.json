  "info": {
    "_postman_id": "f2244c8a-c4ae-47d0-a1cd-57edc887cf25",
    "name": "Fintecture OAuth and Tokens API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Authentication endpoints. The /v1/access-token endpoint issues access tokens via the authorization_code grant (used for AIS code exchange) and the client_credentials grant (used for PIS, Customers, E-Mandates, and OAC). Access tokens are valid for 1 hour and can be refreshed via /v1/refresh-token.\n\n\nContact Support:\n Name: Fintecture Support",
      "type": "text/plain"
    }
  }
