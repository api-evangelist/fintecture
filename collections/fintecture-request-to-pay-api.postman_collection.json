            "description": {
              "content": "Generate a Fintecture payment link. Link can be returned in the response and/or delivered to the customer by email or SMS. Same endpoint backs Immediate Transfer, Smart Transfer, and Buy Now Pay Later.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "pis",
                "v2",
                "request-to-pay"
