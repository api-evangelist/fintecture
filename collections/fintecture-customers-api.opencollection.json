{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fintecture Account Information Services Accounts Customers API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Customers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List All Customers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fintecture.com/v1/customers",
            "params": [
              {
                "name": "page[number]",
                "value": "",
                "type": "query"
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Comprehensive overview of all registered customers."
        },
        {
          "info": {
            "name": "Create Customer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fintecture.com/v1/customers",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Register a customer to accelerate payments."
        },
        {
          "info": {
            "name": "Get A Customer",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fintecture.com/v1/customers/:customer_id",
            "params": [
              {
                "name": "customer_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a customer's details by customer_id."
        }
      ]
    }
  ],
  "bundled": true
}