{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fintecture Account Information Services Accounts Organisation Nodes API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Organisation Nodes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Organisation Node",
            "type": "http"
          },
          "http": {
            "method": "POST",
