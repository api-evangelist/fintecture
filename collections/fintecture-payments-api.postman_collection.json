          "name": "Create A Payment Session",
          "request": {
            "name": "Create A Payment Session",
            "description": {
              "content": "Creates a payment session for a PSU to initiate an Immediate Transfer, Smart Transfer, or Buy Now Pay Later payment. To mix them in a single session, use the Payment Hub semantics. Signature, digest, date and x-request-id headers are mandatory in production.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "pis",
                "v2",
                "connect"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) HTTP message signature (RFC draft-cavage-http-signatures).",
                "key": "Signature",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) SHA-256 digest of the request body, base64-encoded, prefixed with `SHA-256=`.",
                "key": "Digest",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) ",
                "key": "Date",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) Unique request identifier (UUID v4 recommended).",
                "key": "x-request-id",
                "value": "<uuid>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"meta\": {\n    \"psu_name\": \"<string>\",\n    \"psu_email\": \"<email>\",\n    \"psu_phone\": \"<string>\",\n    \"psu_address\": \"<string>\"\n  },\n  \"data\": {\n    \"type\": \"<string>\",\n    \"attributes\": {\n      \"amount\": \"<string>\",\n      \"currency\": \"<string>\",\n      \"communication\": \"<string>\",\n      \"customer_id\": \"<string>\",\n      \"end_to_end_id\": \"<string>\",\n      \"beneficiary\": {\n        \"name\": \"<string>\",\n        \"iban\": \"<string>\",\n        \"bic\": \"<string>\"\n      },\n      \"payment_method\": \"<string>\"\n    }\n  }\n}",
