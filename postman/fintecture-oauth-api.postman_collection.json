{
  "info": {
    "_postman_id": "450a0858-b4dc-4591-8835-0da6c5c82584",
    "name": "Fintecture OAuth and Tokens API",
    "description": "Authentication endpoints. The /v1/access-token endpoint issues access tokens via the authorization_code grant (used for AIS code exchange) and the client_credentials grant (used for PIS, Customers, E-Mandates, and OAC). Access tokens are valid for 1 hour and can be refreshed via /v1/refresh-token.\n\n\nContact Support:\n Name: Fintecture Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-06-05T15:08:41.000Z",
    "updatedAt": "2026-06-05T15:08:42.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-450a0858-b4dc-4591-8835-0da6c5c82584"
  },
